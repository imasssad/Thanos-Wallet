<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App-sandbox stays off: Electron + native modules (keytar, USB
       transports) don't sandbox cleanly on macOS. The hardened runtime
       + notarization still apply. -->
  <key>com.apple.security.app-sandbox</key>
  <false/>

  <!-- Network access — the wallet talks to RPCs, indexer, MultX, Sentry. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Hardware-wallet transports go through native USB / HID.
       Both bits required so the @ledgerhq + @trezor packages can
       enumerate devices via WebHID / WebUSB inside Electron. -->
  <key>com.apple.security.device.usb</key>
  <true/>

  <!-- LAX card identity verification runs in the in-app browser: camera for
       the ID scan + selfie, location when the check asks. Each is used only
       after the user allows it for that page (src/main/dapp-browser.ts). -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!-- Electron / V8 use JIT and writable + executable memory pages.
       Without these, notarization passes but the app crashes on
       launch under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- allow-dyld-environment-variables and disable-library-validation were
       removed here (THN-04c): neither is something this app's own code
       needs — Electron itself doesn't require DYLD_INSERT_LIBRARIES, and
       electron-updater only ever downloads and launches an installer as a
       separate signed process, which isn't gated by this process's own
       library-validation entitlement. Together they let anyone with local
       access set DYLD_INSERT_LIBRARIES (or load an unsigned/mis-signed
       dylib) into a process holding the unlocked seed, which is exactly
       what the hardened runtime above is supposed to prevent. Re-add
       either only alongside a concrete, tested reason a dependency needs
       it (which dependency, which call fails without it). -->
</dict>
</plist>
